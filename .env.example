# Copy this file to .env and fill in what you need:
#   cp .env.example .env
#
# .env is loaded automatically (see load_dotenv() near the top of main.py) —
# no extra package required. It's read from this directory regardless of
# where you run `wx` from. Anything already set in your shell environment
# takes precedence over .env.
#
# .env itself is gitignored — never commit real secrets.

# Only needed for --geo latlng (the default, --geo open-meteo, needs no key).
# LATLNG_API_KEY=your_key_here

# Optional — override where wx stores its cache and config file.
# WX_CACHE_DIR=/path/to/cache
# WX_CONFIG=/path/to/config.json

# Optional — point at a .env file somewhere other than this directory.
# WX_ENV=/path/to/other.env

# Optional — default city when none is given on the command line.
# WX_CITY=Leipzig
